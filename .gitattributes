# 统一行尾，避免脚本在不同系统上失效
* text=auto

# Shell 脚本必须是 LF：带 CRLF 时 macOS / Linux 会报 "\r: command not found"
*.sh text eol=lf

# Windows 批处理必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp3  binary
*.wav  binary
*.mp4  binary
